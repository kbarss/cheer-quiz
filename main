    let currentQ = 0;
    let scores = { mix: 0, perf: 0, hiphop: 0, support: 0 };

    function hideAllScreens() {
      document.getElementById('screen-start').classList.add('hide');
      document.getElementById('screen-quiz').classList.add('hide');
      document.getElementById('screen-result').classList.add('hide');
      document.getElementById('screen-all').classList.add('hide');
    }

    function startQuiz() {
      hideAllScreens();
      document.getElementById('screen-quiz').classList.remove('hide');
      currentQ = 0;
      scores = { mix: 0, perf: 0, hiphop: 0, support: 0 };
      showQuestion();
    }

    function showQuestion() {
      const q = questions[currentQ];
      document.getElementById('step-counter').innerText = `ВОПРОС ${currentQ + 1} ИЗ ${questions.length}`;
      document.getElementById('progress-bar').style.width = `${((currentQ + 1) / questions.length) * 100}%`;
      document.getElementById('question-text').innerText = q.text;

      const container = document.getElementById('options-container');
      container.innerHTML = '';

      q.options.forEach(opt => {
        const btn = document.createElement('div');
        btn.className = 'option-card';
        btn.innerHTML = `<div class="option-bullet"></div><span>${opt.text}</span>`;
        btn.onclick = () => selectOption(opt.scores);
        container.appendChild(btn);
      });
    }

    function selectOption(optScores) {
      for (const [key, val] of Object.entries(optScores)) {
        scores[key] += val;
      }

      currentQ++;
      if (currentQ < questions.length) {
        showQuestion();
      } else {
        showResult();
      }
    }

    function showResult() {
      hideAllScreens();
      document.getElementById('screen-result').classList.remove('hide');

      let maxKey = 'perf';
      let maxScore = -1;
      for (const [key, val] of Object.entries(scores)) {
        if (val > maxScore) {
          maxScore = val;
          maxKey = key;
        }
      }

      const res = directionsData[maxKey];
      document.getElementById('res-title').innerText = res.name;
      document.getElementById('res-img').src = res.image;
      document.getElementById('res-content').innerHTML = res.content;
    }

    function showAllSections() {
      hideAllScreens();
      document.getElementById('screen-all').classList.remove('hide');

      const container = document.getElementById('all-sections-list');
      container.innerHTML = '';

      for (const [key, item] of Object.entries(directionsData)) {
        const wrap = document.createElement('div');
        wrap.innerHTML = `
          <button class="section-tab-btn" onclick="toggleSection('${key}')">
            <span>${item.name}</span>
            <span style="font-size: 13px; color: var(--blue-accent);">▼</span>
          </button>
          <div class="section-tab-content hide" id="sec-content-${key}">
            <div style="width: 100%; height: 160px; border-radius: 8px; overflow: hidden; margin-bottom: 12px;">
              <img src="${item.image}" style="width: 100%; height: 100%; object-fit: cover;" alt="${item.name}">
            </div>
            ${item.content}
          </div>
        `;
        container.appendChild(wrap);
      }
    }

    function toggleSection(key) {
      const el = document.getElementById(`sec-content-${key}`);
      el.classList.toggle('hide');
    }
  </script>
</body>
</html>
